# ConfigMap compreface-admin (non-rahasia). Credential: Secret compreface-postgres-credentials
# (POSTGRES_USER/PASSWORD) & compreface-admin-secrets (SECURITY_SIGNINGKEY, EMAIL_USERNAME/PASSWORD).
TZ=Asia/Jakarta
JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Jakarta
ADMIN_JAVA_OPTS=-XX:MaxRAMPercentage=75.0
SPRING_PROFILES_ACTIVE=dev
POSTGRES_URL=jdbc:postgresql://compreface-postgres-db:5432/frs
PYTHON_URL=http://compreface-core:3000
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=10MB
SAVE_IMAGES_TO_DB=true
ENABLE_EMAIL_SERVER=false
EMAIL_HOST=smtp.example.internal
EMAIL_FROM=CompreFace <no-reply@example.internal>
FRS_CRUD_HOST=http://localhost:8000
MANAGEMENT_SERVER_PORT=8081
MANAGEMENT_HEALTH_MAIL_ENABLED=false
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
LOGGING_LEVEL_COM_EXADEL=INFO
