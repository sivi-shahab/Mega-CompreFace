# ConfigMap compreface-core. Tidak ada credential.
# UWSGI_PROCESSES harus selaras dengan CPU limit (CPU: ≈1 proses per core limit) atau
# VRAM (GPU: ≈2,5 GB per proses InsightFace). Lihat docs/CONFIGURATION.md §sizing.
TZ=Asia/Jakarta
ML_PORT=3000
IMG_LENGTH_LIMIT=640
UWSGI_PROCESSES=2
UWSGI_THREADS=1
UWSGI_MAX_WORKER_LIFETIME=93600
LOGGING_LEVEL_NAME=info
