# ConfigMap compreface-api (non-rahasia). Credential: Secret compreface-postgres-credentials.
TZ=Asia/Jakarta
JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Jakarta
API_JAVA_OPTS=-XX:MaxRAMPercentage=75.0
SPRING_PROFILES_ACTIVE=dev
POSTGRES_URL=jdbc:postgresql://compreface-postgres-db:5432/frs
# URL core via Service ClusterIP (SPEC FR-12)
PYTHON_URL=http://compreface-core:3000
SAVE_IMAGES_TO_DB=true
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=10MB
CONNECTION_TIMEOUT=10000
READ_TIMEOUT=60000
MAX_ATTEMPTS=1
MANAGEMENT_SERVER_PORT=8081
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
LOGGING_LEVEL_COM_EXADEL=INFO
