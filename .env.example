# .env.example — salin ke .env lalu isi nilai yang ditandai WAJIB.  (.env tidak di-commit)
# Nama variabel sama dengan ConfigMap/Secret di k8s/. Referensi: docs/CONFIGURATION.md

# --- Compose & image ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=compreface
# Prefix registry DENGAN garis miring di akhir, kosong = image lokal (mega/...)
REGISTRY=
FE_VERSION=1.2.0
ADMIN_VERSION=1.2.0
API_VERSION=1.2.0
CORE_VERSION=1.2.0
# Dipakai docker-compose.gpu.yml
CORE_GPU_VERSION=1.2.0-arcface-r100-gpu
POSTGRES_VERSION=1.2.0
FE_HTTP_PORT=8000
TZ=Asia/Jakarta

# --- Secret (WAJIB, jangan commit) ---------------------------------------------------
POSTGRES_USER=compreface
# WAJIB — contoh: openssl rand -base64 24
POSTGRES_PASSWORD=
# WAJIB — contoh: openssl rand -hex 32
SECURITY_SIGNINGKEY=
# Hanya bila ENABLE_EMAIL_SERVER=true
EMAIL_USERNAME=
EMAIL_PASSWORD=

# --- Database ------------------------------------------------------------------------
POSTGRES_DB=frs

# --- admin / api -----------------------------------------------------------------------
ADMIN_JAVA_OPTS=-XX:MaxRAMPercentage=75.0
API_JAVA_OPTS=-XX:MaxRAMPercentage=75.0
ADMIN_MEM_LIMIT=1536m
API_MEM_LIMIT=3g
SAVE_IMAGES_TO_DB=true
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=10MB
CONNECTION_TIMEOUT=10000
READ_TIMEOUT=60000
MAX_ATTEMPTS=1
LOGGING_LEVEL_COM_EXADEL=INFO
ENABLE_EMAIL_SERVER=false
EMAIL_HOST=smtp.example.internal
EMAIL_FROM=CompreFace <no-reply@example.internal>
FRS_CRUD_HOST=http://localhost:8000

# --- core ------------------------------------------------------------------------------
IMG_LENGTH_LIMIT=640
UWSGI_PROCESSES=2
UWSGI_THREADS=1
UWSGI_MAX_WORKER_LIFETIME=93600
LOGGING_LEVEL_NAME=info
CORE_MEM_LIMIT=6g
# Dipakai docker-compose.gpu.yml
CORE_GPU_MEM_LIMIT=12g

# --- fe --------------------------------------------------------------------------------
CLIENT_MAX_BODY_SIZE=10M
