# build-args.env — varian build compreface-core
#
# Format INI sederhana: [nama-varian] lalu KEY=VALUE (tanpa kutip, tanpa spasi di sekitar "=").
# Dibaca oleh scripts/build.sh:  scripts/build.sh core --variant <nama-varian>
#
# Kunci khusus (bukan build arg Docker):
#   TAG_SUFFIX  suffix tag image → <version><TAG_SUFFIX>   (varian default: kosong)
#   COMPUTE     cpu | gpu  → memilih stage base di Dockerfile
# Kunci lain diteruskan sebagai --build-arg KEY=VALUE:
#   FACE_DETECTION_PLUGIN, CALCULATION_PLUGIN, EXTRA_PLUGINS  (format: backend.Class[@model])
#   GPU_IDX            -1 = CPU, 0 = GPU pertama
#   INTEL_OPTIMIZATION true|false (MKL)
#   SKIP_TESTS         kosong = jalankan pytest saat build; 1 = lewati (wajib untuk GPU)
#   MODEL_SOURCE       image (default) | gdrive
#   MODELS_IMAGE       image sumber /app/ml/.models bila MODEL_SOURCE=image. Di-pin digest ke image
#                      resmi Exadel yang memuat model plugin yang sama. Varian GPU memakai image CPU
#                      bermodel sama (ukuran unduhan lebih kecil). Untuk build di jaringan internal,
#                      arahkan ke mirror di registry internal dengan digest yang sama.
#
# Mengapa bukan Google Drive: per 2026-09 file model upstream di Google Drive meminta sign-in
# (gdown gagal "Access denied"). Lihat docs/adr/ADR-002.
#
# Sumber nilai: embedding-calculator/Dockerfile (default) dan embedding-calculator/Makefile
# upstream 1.2.0. PERHATIAN: model calculator yang berbeda menghasilkan embedding yang TIDAK
# kompatibel — ganti varian di environment yang sudah berisi data = migrasi (lihat docs/MIGRATION.md).

# Default = image resmi exadel/compreface-core:1.2.0 (FaceNet, CPU). Tag: 1.2.0
[default]
TAG_SUFFIX=
COMPUTE=cpu
GPU_IDX=-1
INTEL_OPTIMIZATION=false
FACE_DETECTION_PLUGIN=facenet.FaceDetector
CALCULATION_PLUGIN=facenet.Calculator
EXTRA_PLUGINS=facenet.LandmarksDetector,agegender.AgeDetector,agegender.GenderDetector,facenet.facemask.MaskDetector,facenet.PoseEstimator
SKIP_TESTS=
MODEL_SOURCE=image
MODELS_IMAGE=exadel/compreface-core:1.2.0@sha256:c9c70f0f270b1767bdf59d8e549f00f7d8f06e29315ac2ff624e276dcf37385b

# SubCenter-ArcFace r100 + RetinaFace r50, GPU. Dipakai PRODUKSI (embedding produksi memakai
# insightface.Calculator@arcface-r100-msfdrop75). Tag: 1.2.0-arcface-r100-gpu
[arcface-r100-gpu]
TAG_SUFFIX=-arcface-r100-gpu
COMPUTE=gpu
GPU_IDX=0
INTEL_OPTIMIZATION=false
FACE_DETECTION_PLUGIN=insightface.FaceDetector@retinaface_r50_v1
CALCULATION_PLUGIN=insightface.Calculator@arcface-r100-msfdrop75
EXTRA_PLUGINS=insightface.LandmarksDetector,insightface.GenderDetector,insightface.AgeDetector,insightface.facemask.MaskDetector,insightface.PoseEstimator
SKIP_TESTS=1
MODEL_SOURCE=image
MODELS_IMAGE=exadel/compreface-core:1.2.0-arcface-r100@sha256:bc8b3831580ab3a21a0467bf0f8bf21113e1047fb24a7bb008a1fc69cca633db

# Model sama dengan produksi, tanpa GPU (lambat; untuk DR/uji tanpa node GPU). Tag: 1.2.0-arcface-r100
[arcface-r100]
TAG_SUFFIX=-arcface-r100
COMPUTE=cpu
GPU_IDX=-1
INTEL_OPTIMIZATION=false
FACE_DETECTION_PLUGIN=insightface.FaceDetector@retinaface_r50_v1
CALCULATION_PLUGIN=insightface.Calculator@arcface-r100-msfdrop75
EXTRA_PLUGINS=insightface.LandmarksDetector,insightface.GenderDetector,insightface.AgeDetector,insightface.facemask.MaskDetector,insightface.PoseEstimator
SKIP_TESTS=
MODEL_SOURCE=image
MODELS_IMAGE=exadel/compreface-core:1.2.0-arcface-r100@sha256:bc8b3831580ab3a21a0467bf0f8bf21113e1047fb24a7bb008a1fc69cca633db

# Build eksplisit FaceNet (identik dengan default, tag bersuffix seperti upstream). Tag: 1.2.0-facenet
[facenet]
TAG_SUFFIX=-facenet
COMPUTE=cpu
GPU_IDX=-1
INTEL_OPTIMIZATION=false
FACE_DETECTION_PLUGIN=facenet.FaceDetector
CALCULATION_PLUGIN=facenet.Calculator
EXTRA_PLUGINS=facenet.LandmarksDetector,agegender.GenderDetector,agegender.AgeDetector,facenet.facemask.MaskDetector,facenet.PoseEstimator
SKIP_TESTS=
MODEL_SOURCE=image
MODELS_IMAGE=exadel/compreface-core:1.2.0-facenet@sha256:28f78f08c988b0cf95537f39f6ebbb686ac9ee94bfe1d1eb5e8d070a804e9ed4

# MobileFaceNet + RetinaFace mnet025 (ringan, akurasi lebih rendah). Tag: 1.2.0-mobilenet
[mobilenet]
TAG_SUFFIX=-mobilenet
COMPUTE=cpu
GPU_IDX=-1
INTEL_OPTIMIZATION=false
FACE_DETECTION_PLUGIN=insightface.FaceDetector@retinaface_mnet025_v1
CALCULATION_PLUGIN=insightface.Calculator@arcface_mobilefacenet
EXTRA_PLUGINS=insightface.LandmarksDetector,insightface.GenderDetector,insightface.AgeDetector,insightface.facemask.MaskDetector,insightface.PoseEstimator
SKIP_TESTS=
MODEL_SOURCE=image
MODELS_IMAGE=exadel/compreface-core:1.2.0-mobilenet@sha256:a8878d0fafe9090662a1c67c7998591bab19aa417a0a64a07445d51293164ab6

# Tag: 1.2.0-mobilenet-gpu
[mobilenet-gpu]
TAG_SUFFIX=-mobilenet-gpu
COMPUTE=gpu
GPU_IDX=0
INTEL_OPTIMIZATION=false
FACE_DETECTION_PLUGIN=insightface.FaceDetector@retinaface_mnet025_v1
CALCULATION_PLUGIN=insightface.Calculator@arcface_mobilefacenet
EXTRA_PLUGINS=insightface.LandmarksDetector,insightface.GenderDetector,insightface.AgeDetector,insightface.facemask.MaskDetector,insightface.PoseEstimator
SKIP_TESTS=1
MODEL_SOURCE=image
MODELS_IMAGE=exadel/compreface-core:1.2.0-mobilenet@sha256:a8878d0fafe9090662a1c67c7998591bab19aa417a0a64a07445d51293164ab6
