# Template server compreface-fe — dirender oleh envsubst saat container start
# (/etc/nginx/templates/*.template → /etc/nginx/conf.d/*.conf).
#
# Perbedaan dari ui/nginx/templates/nginx.conf.template upstream:
#  1. Tidak ada blok "upstream" statis. Host di-resolve saat request lewat "resolver" +
#     proxy_pass berbasis variabel, sehingga nginx tidak crash ("host not found in upstream")
#     bila admin/api belum ada, dan IP baru di-refresh tiap ${NGINX_RESOLVER_VALID}.
#  2. Hostname upstream dari env: ${ADMIN_UPSTREAM}, ${API_UPSTREAM}, ${CORE_UPSTREAM}.
#  3. Route /core/ DIHAPUS — core hanya boleh diakses api/admin di dalam cluster.
#     Pengecualian: GET /core/status (exact match). UI menahan seluruh halaman sampai
#     endpoint ini mengembalikan status "OK" (app.component + servers-status effects) dan
#     memakai available_plugins-nya. Isinya hanya status + nama model, tanpa data wajah.
#  4. Listen 8080 (non-root) + endpoint /healthz untuk probe.

resolver ${NGINX_RESOLVER} valid=${NGINX_RESOLVER_VALID} ipv6=off;
resolver_timeout 5s;

server {
    listen 8080;
    server_name ui;

    set $admin_upstream ${ADMIN_UPSTREAM};
    set $api_upstream ${API_UPSTREAM};
    set $core_upstream ${CORE_UPSTREAM};

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        root /usr/share/nginx/html/;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # index.html (termasuk fallback SPA untuk path apa pun) tidak boleh di-cache browser.
    # Tanpa ini browser memakai heuristic caching dari Last-Modified, sehingga respons
    # fallback untuk URL API/status (mis. /core/status sebelum route-nya ada) dan
    # index.html lama setelah deploy bisa dipakai ulang berjam-jam tanpa request ke server.
    # Aset build ber-hash (*.js, *.css) tetap boleh di-cache.
    location = /index.html {
        root /usr/share/nginx/html/;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        expires off;
    }

    location /admin/ {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Tanpa URI di proxy_pass → request URI (/admin/...) diteruskan apa adanya.
        proxy_pass http://$admin_upstream;
    }

    location /api/v1/ {
        proxy_read_timeout ${PROXY_READ_TIMEOUT};
        proxy_connect_timeout ${PROXY_CONNECT_TIMEOUT};

        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '*';
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, PUT, DELETE';
            add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,x-api-key';
            add_header 'Access-Control-Max-Age' 1728000;
            add_header 'Content-Type' 'text/plain charset=UTF-8';
            add_header 'Content-Length' 0;
            return 204;
        }

        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, PUT, DELETE' always;
        add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,x-api-key' always;

        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://$api_upstream;
    }

    # Satu-satunya endpoint core yang terbuka lewat fe (lihat catatan 3 di atas).
    location = /core/status {
        limit_except GET {
            deny all;
        }
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
        proxy_pass http://$core_upstream/status;
    }

    # Swagger UI admin & api (upstream: /(api|admin)/swagger-ui.html → /swagger-ui.html pada service).
    location ~ ^/admin/(swagger-ui.html|webjars|swagger-resources|v2/api-docs)(.*) {
        proxy_set_header Host $http_host;
        proxy_pass http://$admin_upstream/$1$2$is_args$args;
    }

    location ~ ^/api/(swagger-ui.html|webjars|swagger-resources|v2/api-docs)(.*) {
        proxy_set_header Host $http_host;
        proxy_pass http://$api_upstream/$1$2$is_args$args;
    }
}
